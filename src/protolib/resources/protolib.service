[Unit]
Description=protolib server
After=network.target

[Service]
Type=simple
# Update the path below if your project is not under ~/repos/
WorkingDirectory=%h/repos/protolib
ExecStart=%h/repos/protolib/.venv/bin/python -m protolib server -v 1
Restart=on-failure
RestartSec=5
Environment=pg_alias=proto
Environment=port=9001

[Install]
WantedBy=default.target
